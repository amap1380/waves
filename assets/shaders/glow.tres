[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform vec4 MaskColor : source_color;
instance uniform float FloatParameter : hint_range(0.0010000000475, 1.0);
instance uniform vec4 GlowColor : source_color;



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// ColorParameter:3
	vec4 n_out3p0 = MaskColor;


// ColorOp:4
	vec3 n_out4p0 = abs(vec3(n_out2p0.xyz) - vec3(n_out3p0.xyz));


// FloatParameter:6
	float n_out6p0 = FloatParameter;


	vec3 n_out5p0;
// If:5
	float n_in5p1 = 0.00000;
	vec3 n_in5p3 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_in5p4 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in5p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out4p0.x - n_in5p1) < n_out6p0)
	{
		n_out5p0 = n_in5p3;
	}
	else if(n_out4p0.x < n_in5p1)
	{
		n_out5p0 = n_in5p5;
	}
	else
	{
		n_out5p0 = n_in5p4;
	}


// ColorParameter:8
	vec4 n_out8p0 = GlowColor;


	vec3 n_out7p0;
// Switch:7
	n_out7p0 = mix(vec3(n_out2p0.xyz), vec3(n_out8p0.xyz), float(all(bvec3(n_out5p0))));


// Output:0
	COLOR.rgb = n_out7p0;


}
